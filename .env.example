MYSQL_ROOT_PASSWORD=change-me
DATABASE_URL=mysql+asyncmy://root:${MYSQL_ROOT_PASSWORD}@127.0.0.1:3306/rag
MODEL_RELAY_BASE_URL=http://127.0.0.1:9000/v1
MODEL_RELAY_API_KEY=change-me
EMBEDDING_MODEL=local-embedding
EMBEDDING_BASE_URL=http://127.0.0.1:9000/v1
EMBEDDING_API_KEY=change-me
CHAT_MODEL=local-chat

# Controller 在平台部署时覆盖；本地 Compose 使用下列非密钥标识。
RPA_APP_KEY=rag-database
RPA_ENVIRONMENT=LOCAL
RPA_RELEASE_VERSION=dev
RPA_SOURCE_COMMIT=local
RPA_CONFIG_VERSION=

# Conformance 无数据库模式（黑盒门禁）：置 true 后不依赖数据库/模型服务，
# 门禁夹具 TEST_* 由中央 runner 注入，仅从环境读取、不得写入代码或提交。
RPA_CONFORMANCE_MODE=false

# 平台生产密钥（TEST/PRODUCTION）只从 /run/tyt-rpa/secrets/ 按文件名读取，不经过本文件：
#   CONTROL_PLANE_TLS_CA_CERTIFICATE / RPA_CONTROL_PLANE_BASE_URL
#   RPA_PROJECT_SERVICE_CLIENT_ID / RPA_PROJECT_SERVICE_SECRET / RPA_PROJECT_SERVICE_SECRET_VERSION
#   DATABASE_HOST / DATABASE_PORT / DATABASE_SCHEMA
#   DATABASE_RUNTIME_USERNAME / DATABASE_RUNTIME_PASSWORD / DATABASE_TLS_CA_CERTIFICATE


# ── 视频解析 agent：ASR（火山引擎语音技术 · 大模型录音文件极速识别 flash）──
VOLC_ASR_API_KEY=
VOLC_ASR_APP_ID=
VOLC_ASR_ACCESS_TOKEN=
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# ── 视频解析 agent：Chat（豆包方舟，OpenAI 兼容）──
VOLC_CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_CHAT_MODEL=doubao-seed-2-1-turbo-260628
VOLC_CHAT_API_KEY=
